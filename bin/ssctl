#!/usr/bin/env python3
import subprocess
import sys
import time
import xml.etree.ElementTree as ET
from argparse import ArgumentParser
from pathlib import Path


def xml_to_dict(xml):
    return {
        attr.get('name'): attr.text
        for attr in xml.findall('attribute')
    }


class SelfService:
    def __init__(self):
        self.path = Path.home() / 'Library/Application Support/osx-self-service.Self-Service.resources/CocoaAppCD.storedata'
        self.parse()

    def parse(self):
        self.catalog = {}
        root = ET.parse(self.path).getroot()
        for obj in root.findall('object'):
            if obj.get('type') != 'SSPOLICY':
                continue
            data = xml_to_dict(obj)

            # skip duplicate names if initial policy is already installed
            if data['name'] in self.catalog and self.catalog[data['name']]['installed']:
                continue

            self.catalog[data['name']] = {
                'id': data['id'],
                'installed': False if data['installstatus'] == '0' else True,
            }

    def list_policies(self):
        padding = max(len(str(value['id'])) for value in self.catalog.values())
        for key in sorted(self.catalog, key=str.casefold):
            print(f"{self.catalog[key]['id']:<{padding}} | {key}")

    def display_policy(self, name):
        policy = self.catalog.get(name, None)
        if policy is None:
            return
        print(f"{'Policy ID:':<10} {policy['id']}")
        print(f"{'Name:':<10} {name}")
        print(f"{'Installed:':<10} {policy['installed']}")

    def install_policy(self, name):
        policy = self.catalog.get(name, None)
        if policy is None or policy['installed'] is True:
            return
        try:
            subprocess.run(['sudo', 'jamf', 'policy', '-id', policy['id']], check=True)
        except subprocess.CalledProcessError as e:
            print(f"Failed to install {name} (exit code {e.returncode})", file=sys.stderr)

    def install_policy_file(self, filename):
        with open(Path.cwd() / filename, 'r') as f:
            policies = [line.strip() for line in f.readlines()]
        for policy in policies:
            self.install_policy(policy)

    def open(self):
        try:
            subprocess.run(['open', '-gj', '-a', "Self Service+"], check=True)
        except subprocess.CalledProcessError as e:
            print(f"Failed to open Self Service+ (exit code {e.returncode})", file=sys.stderr)

    def quit(self):
        try:
            subprocess.run('osascript -e \'quit app "Self Service+"\'', check=True, shell=True)
        except subprocess.CalledProcessError as e:
            print(f"Failed to quit Self Service+ (exit code {e.returncode})", file=sys.stderr)


def main():
    parser = ArgumentParser()
    subparsers = parser.add_subparsers(dest='command', required=True)
    subparsers.add_parser('list')
    policy_parser = subparsers.add_parser('policy')
    policy_parser.add_argument('name')
    install_parser = subparsers.add_parser('install')
    install_parser.add_argument('name', nargs='?')
    install_parser.add_argument('--file', '-f', dest='filename')
    args = parser.parse_args()

    ss = SelfService()

    match args.command:
        case 'list':
            ss.list_policies()
        case 'policy':
            ss.display_policy(args.name)
        case 'install':
            name, filename = args.name, args.filename
            if not name and not filename:
                install_parser.error('specify either name or --file')
            elif name and filename:
                install_parser.error('the following arguments are required: name')
            elif name:
                ss.install_policy(name)
            else:
                ss.quit()
                ss.install_policy_file(filename)
                ss.open()
                time.sleep(4)
                ss.quit()


if __name__ == '__main__':
    main()
