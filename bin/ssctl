#!/usr/bin/env python3
import xml.etree.ElementTree as ET
from argparse import ArgumentParser
from pathlib import Path


def xml_to_dict(xml):
    return {
        attr.get('name'): attr.text
        for attr in xml.findall('attribute')
    }


class SelfService:
    def __init__(self):
        self.path = Path.home() / 'Library/Application Support/osx-self-service.Self-Service.resources/CocoaAppCD.storedata'
        self.parse()

    def parse(self):
        self.catalog = {}
        root = ET.parse(self.path).getroot()
        for obj in root.findall('object'):
            if obj.get('type') == 'SSCATEGORY':
                continue
            data = xml_to_dict(obj)
            self.catalog[data['name']] = data['id']

    def list(self):
        padding = max(len(str(key)) for key in self.catalog)
        for key in sorted(self.catalog, key=str.casefold):
            print(f"{key:<{padding}} | {self.catalog[key]}")



def main():
    parser = ArgumentParser()
    parser.add_argument('command')
    args = parser.parse_args()
    command = args.command

    ss = SelfService()

    if command == 'list':
        ss.list()


if __name__ == '__main__':
    main()
